# ==========================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU & SERVER
# ==========================================
DATABASE_URL=sqlite:///./nhamay.db
# Hoặc PostgreSQL trên Supabase/Neon/Render:
# DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/nhamay

BACKEND_URL=https://your-backend-app.onrender.com
# RENDER_EXTERNAL_URL do Render tự động cấp

# ==========================================
# CẤU HÌNH LƯU TRỮ ẢNH VĨNH VIỄN (TÙY CHỌN)
# ==========================================
# LƯU Ý: Mặc định hệ thống đã tự động nén và lưu ảnh an toàn vào Database (Base64 Data URL)
# đảm bảo KHÔNG BAO GIỜ MẤT ẢNH khi Render/Vercel khởi động lại.
#
# Nếu muốn dùng CDN tốc độ cao miễn phí, bạn có thể cấu hình 1 trong 2 dịch vụ sau:

# Cách 1: Cloudinary (Khuyên dùng - Miễn phí 25GB, CDN toàn cầu)
# Đăng ký tại https://cloudinary.com/
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Hoặc:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Cách 2: ImgBB (Cực kỳ đơn giản - Miễn phí vĩnh viễn)
# Lấy API Key tại https://api.imgbb.com/
# IMGBB_API_KEY=your_imgbb_api_key
